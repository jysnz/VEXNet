# Copy to .env.local for local runs; on Vercel set these in Project Settings -> Environment Variables.

# PIN typed on the control page (phone / tablet / laptop). Required.
CONTROL_PIN=change-me

# Shared secret the relay laptops use. Required. Long and random, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
RELAY_TOKEN=change-me-too-long-and-random

# Match state storage: Upstash Redis (Vercel Marketplace -> Storage -> Upstash Redis) sets these for you.
# Leave them out to run locally with in-memory storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
